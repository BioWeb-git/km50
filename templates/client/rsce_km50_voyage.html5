									<?php $prix = (array) $prix_detaille; ?>
									<li>
										<?php echo ($prix['titre_prix'] === 'custom' && !empty($prix['titre_prix_custom'])) ? $prix['titre_prix_custom'] : $prix['titre_prix']; ?>&nbsp;: <strong><?php echo $prix['prix'] ?>&nbsp;€&nbsp;/&nbsp;pers</strong>
									</li>
								<?php endforeach; ?>
								<li>
									<?php if ($this->mention_prix == ''): ?>
