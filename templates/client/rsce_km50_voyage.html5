									'peages' => 'Les péages éventuels',
									'depenses' => 'Les dépenses personnelles',
									'dejeuner' => 'Les déjeuners',
									'boissons' => 'Les boissons pendant les repas',
								];
								$excluCoches = \Contao\StringUtil::deserialize($this->ce_prix_ne_comprend_pas_labels, true);
								foreach ($excluCoches as $k) {
									if (isset($labelsExclu[$k])) echo '<li>' . $parseBold($labelsExclu[$k]) . '</li>';
								}
								if (is_array($this->ce_prix_ne_comprend_pas_extra)) {
									foreach ($this->ce_prix_ne_comprend_pas_extra as $extra) {
