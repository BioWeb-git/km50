					<?php endif; ?>
					
					<div class="inclusions-box">
						<h3>Ce prix comprend</h3>
						<ul>
							<?php
								$labelsComprend = [
									'conception' => 'La Conception et l’organisation du séjour par <strong>KM50</strong>',
									'accompagnement' => 'L’accompagnement de <strong>KM50</strong>',
									'accompagnement_concession' => 'L’accompagnement de la concession',
									'traces' => 'Les tracés et le roadbook',
									'pauses' => 'Les pauses café pendant les balades motos',
									'assurance_annul' => 'L’assurance annulation et interruption de voyage (sans franchise)',
									'assurance_multi' => 'L’assurance multirisques (annulation & frais médicaux - sans franchise)',
								];
								
								// Fonction pour transformer **texte** ou ***texte*** en <strong>texte</strong>
								$parseBold = function($text) {
									return preg_replace('/\*{2,3}([^\*]+)\*{2,3}/', '<strong>$1</strong>', $text);
								};

								$comprendCoches = \Contao\StringUtil::deserialize($this->ce_prix_comprend_labels, true);
								foreach ($comprendCoches as $k) {
									if (isset($labelsComprend[$k])) echo '<li>' . $parseBold($labelsComprend[$k]) . '</li>';
								}
								if (is_array($this->ce_prix_comprend_extra)) {
									foreach ($this->ce_prix_comprend_extra as $extra) {
										$extra = (array)$extra;
										if (!empty($extra['text'])) echo '<li>' . $parseBold($extra['text']) . '</li>';
									}
								}
							?>
						</ul>
						<?php if ($this->assurance_destination === 'annulation'): ?>
							<p><a class="link" href="https://drive.google.com/file/d/1YO0bqLJCHgQiKgQeBcd8_TakPspBlO5Y/view?usp=drive_link" target="_blank" rel="noopener"><i class="fa fa-external-link"></i> Information assurance annulation</a></p>
						<?php elseif ($this->assurance_destination === 'multirisk'): ?>
							<p><a class="link" href="https://drive.google.com/file/d/1y9_Uibrtn7qzi4AIX7fN2HzBFMQxsQif/view?usp=drive_link" target="_blank" rel="noopener"><i class="fa fa-external-link"></i> Information assurance multirisques</a></p>
						<?php endif; ?>
