<?php
// =========================================================================================
// SÉCURISATION DE L'ID DE PAGE : On utilise une variable temporaire pour l'ID de la page
$GLOBALS['TL_HEAD'][] = sprintf('
	<script async src="https://tally.so/widgets/embed.js"></script>
');
$currentPageId = 0;
if (isset($GLOBALS['objPage']) && is_object($GLOBALS['objPage'])) {
    $currentPageId = $GLOBALS['objPage']->id;
}
$organisateur = $GLOBALS['organisateur'] ?? null;
$thematique   = $GLOBALS['thematique']   ?? null;
$region       = $GLOBALS['region']       ?? null;
$dispoLabels = [
    'complet' => 'Complet',
    'last'    => 'Dernières places'
];
$GLOBALS['disponibilite'] = isset($dispoLabels[$this->disponibilite]) ? $dispoLabels[$this->disponibilite] : null;
$GLOBALS['disponibilite_class'] = $this->disponibilite;
$objFile = \Contao\FilesModel::findByUuid($this->photos_organisateur); 
$photoUuid = null;
if (is_array($this->photo) && !empty($this->photo[0])) {
    $photoUuid = $this->photo[0];
} elseif (is_string($this->photo) && !empty($this->photo)) {
    $photoUuid = $this->photo;
}

	$GLOBALS['organisateur'] = null;
	$GLOBALS['thematique']   = null;
	$GLOBALS['region']       = null; 

?>
<div class="voyage-wrapper">
	<div class="voyage-content">
		
		<div class="voyage-content-wrapper">
			<?php if ($this->nb_jours > 0 || $this->nb_nuits > 0): ?>
				<div class="voyage-top-infos">
					<div class="voyage-duree bb">
						{{fa::clock}} 
						<?php if ($this->nb_jours > 0): ?>
							<?php echo $this->nb_jours; ?> jour<?php echo ($this->nb_jours > 1) ? 's' : ''; ?>
						<?php endif; ?>

						<?php if ($this->nb_jours > 0 && $this->nb_nuits > 0): ?>&nbsp;/&nbsp;<?php endif; ?>

						<?php if ($this->nb_nuits > 0): ?>
							<?php echo $this->nb_nuits; ?> nuit<?php echo ($this->nb_nuits > 1) ? 's' : ''; ?>
						<?php endif; ?>
					</div>
				</div>
			<?php endif; ?>
			<?php if ($region): ?>
				<div class="region bb"><strong>Région&nbsp;: </strong><?php echo $region ?></div>
			<?php endif ?>
			<?php if ($organisateur): ?>
				<div class="brand bb"><strong>Organisateur&nbsp;: </strong><?php echo $organisateur ?></div>
			<?php endif ?>
			<?php if ($thematique): ?>
				<div class="thematique bb"><strong>Thème&nbsp;: </strong><?php echo $thematique ?></div>
			<?php endif ?>
				
			<div class="voyage-dates bb">
				<strong>Dates&nbsp;:</strong>
				<ul class="voyage-dates-liste">
					<?php if (is_array($this->dates_liste) && count($this->dates_liste)): ?>
						<?php foreach ($this->dates_liste as $index => $date): ?>
							<li>
								<?php 
									$date = (array) $date; 
									echo $date['date_range'];
								?>
							</li>
						<?php endforeach ?>
					<?php else: ?>
						Date non spécifiée
					<?php endif ?>
				</ul>
			</div>
			<?php if ($this->prix_partir_de): ?>
				<div class="voyage-prix bb">
					<strong>Prix&nbsp;:</strong> 
					A partir de <?php echo $this->prix_partir_de; ?>&nbsp;€&nbsp;TTC
				</div>
			<?php endif; ?>
			<div class="voyage-logement bb">
				<strong>Logement&nbsp;:</strong>
				<?php
					// Correspondance Clé => Label (car le template n'a pas toujours accès au DCA)
					$labels = [
						'gite'          => 'Gîte',
						'chambre_hote'  => 'Chambre d\'hôtes',
						'maison_privee' => 'Maison Privée',
						'hotel_2'       => 'Hotel **',
						'hotel_3'       => 'Hotel ***',
						'hotel_4'       => 'Hotel ****',
						'hotel_5'       => 'Hotel *****',
						'tente'         => 'Tente',
					];

					// Transformation de la donnée brute en tableau PHP
					$valeurs = \Contao\StringUtil::deserialize($this->logement, true);

					// Récupération des bons libellés
					$affichage = array_map(function($v) use ($labels) {
						return $labels[$v] ?? $v;
					}, $valeurs);

					// Affichage séparé par des virgules
					echo implode(' | ', $affichage);
				?>
			</div>
			<div class="voyage-participants bb">
				<strong>Participants&nbsp;:</strong> 
				Min <?php echo $this->min_participants ?> - Max <?php echo $this->max_participants ?> 
				<?php 
					$isPluriel = ($this->max_participants > 1);
					if ($this->type_voyage == 'auto') {
						echo $isPluriel ? 'Équipages' : 'Équipage';
					} elseif ($this->type_voyage == 'moto') {
						echo $isPluriel ? 'Motos' : 'Moto';
					}
				?>
			</div>
			<div class="voyage-date-limite bb"><strong>Date limite d'inscription&nbsp;:</strong> <?php echo date('d/m/Y', is_numeric($this->date_limite) ? $this->date_limite : strtotime($this->date_limite)); ?></div>
		</div>
	</div>
	
	<?php if ($currentPageId == 306): ?>
		<div class="voyage-detail">

			
			<section class="voyage-introduction">
				<h2 class="voyage-titles sr-only">Présentation</h2>
				<?php echo $this->description_fiche ?>
			</section>
			<?php if ($objFile): ?>
				<img class="voyage-organisateur-logo" src="<?= $objFile->path ?>" alt="Logo organisateur">
			<?php endif; ?>
			<?php if ($this->youtube_video): ?>
				<div class="voyage-video">
					<?php if ($GLOBALS['disponibilite']): ?>
						<div class="voyage-disponibilite">
							<?= $GLOBALS['disponibilite'] ?>
						</div>
					<?php endif; ?>
					<h2 class="voyage-titles">Vidéo de Présentation</h2>
					<div class="content-youtube">
						<figure class="aspect aspect--16:9">
							<iframe allowfullscreen src="https://www.youtube.com/embed/<?php echo $this->youtube_video ?>?rel=0&amp;autohide=1&amp;showinfo=0" frameborder="0"></iframe>
						</figure>
					</div>
				</div>
			<?php endif; ?>
			<section class="voyage-programme">
				<h2 class="voyage-titles">Programme du Voyage</h2>
				<?php if ($this->programme && is_array($this->programme)): ?>
					<?php foreach ($this->programme as $index => $jour): ?>
						<?php $jour = (array) $jour;?>
						<article class="programme-jour">
							<h3>Jour <?php echo $index + 1 ?>&nbsp;: <?php echo $jour['titre_jour'] ?></h3>
							<div class="description-jour">
								<?php echo $jour['description_jour'] ?>
							</div>
						</article>
					<?php endforeach ?>
				<?php endif ?>
			</section>

			<section class="voyage-prix-inclusions">
				<h2 class="voyage-titles">Détails et Tarifs</h2>

				<div class="voyage-documents">
					<h3>Document(s) obligatoire(s)</h3>
					<strong><?php
						$docLabels = [
							'permis'    => 'Permis',
							'assurance' => 'Assurance',
							'cni'       => 'Carte d\'identité',
							'passeport' => 'Passeport',
							'visa'      => 'Visa',
						];

						$docsCoches = \Contao\StringUtil::deserialize($this->documents_indispensables, true);
						
						$listeDocs = array_map(function($d) use ($docLabels) {
							return $docLabels[$d] ?? $d;
						}, $docsCoches);

						echo implode(', ', $listeDocs);
					?></strong>
				</div>
				<div class="voyage-prix-inclusions-wrapper">
						
					<?php if (!empty($this->prix_detaille)): ?>
						<div class="prix-box">
							
							<h3>Tarifs</h3>
							<ul>
								<?php foreach ($this->prix_detaille as $index => $prix_detaille): ?>
									<?php $prix = (array) $prix_detaille; ?>
									<li>
										<?php echo $prix['titre_prix'] ?>&nbsp;: <strong><?php echo $prix['prix'] ?>&nbsp;€&nbsp;/&nbsp;pers</strong>
									</li>
								<?php endforeach; ?>
								<li>
									<?php if ($this->mention_prix == ''): ?>
										Possibilité de règlement en plusieurs fois : 50% d'acompte à la réservation
									<?php else: ?>
										<?php echo $this->mention_prix ?>
									<?php endif; ?>
								</li>
							</ul>
						</div>
					<?php endif; ?>
					
					<div class="inclusions-box">
						<h3>Ce prix comprend</h3>
						<?php echo $this->ce_prix_comprend ?>
					</div>
					
					<div class="exclusions-box">
						<h3>Ce prix ne comprend pas</h3>
						<?php echo $this->ce_prix_ne_comprend_pas ?>
					</div>
				</div>
			</section>
			<section class="voyage-galerie">
				<h2 class="voyage-titles">Photos du Séjour</h2>
				<?php if ($this->photos_fiche && is_array($this->photos_fiche)): ?>
					<div class="gallery-container">
						<?php foreach ($this->photos_fiche as $uuid): ?>
							<figure class="gallery-item">
								<!-- Rendu des images de la galerie (ex: en 800px de large, hauteur auto) -->
								{{image::<?= $uuid ?>?width=800&alt=<?= htmlspecialchars($this->titre_liste) ?> - Photo}}
							</figure>
						<?php endforeach ?>
					</div>
				<?php else: ?>
					<div class="gallery-placeholder">
						Aucune image pour la galerie.
					</div>
				<?php endif ?>
			</section>

		</div>
		<?php if ($this->reservation_tally_id): ?>	
			<div class="voyage-reservation">
				<h2 class="voyage-titles">
					Réservation
					<?php if ($this->date_limite): ?>
						<span class="date-deadline">
							avant le <?php echo date('d/m/Y', is_numeric($this->date_limite) ? $this->date_limite : strtotime($this->date_limite)); ?>
						</span>
					<?php endif; ?>
				</h2>
				<iframe data-tally-src="https://tally.so/embed/<?= $this->reservation_tally_id ?>?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1" loading="lazy" width="100%" height="200" frameborder="0" marginheight="0" marginwidth="0" title="Réservation Séjour Échappée Gourmande en Aubrac 2026"></iframe>
				<script>var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}</script>
			</div>		
		<?php endif;?>
	<?php endif;?>
	
</div>
