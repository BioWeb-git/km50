<?php 
  // 1. Initialisation des variables
  $organisateur = null;
  $region       = null;
  $thematique   = null;

  // 2. Tri des catégories
  if ($this->categories && is_array($this->categories)) {
      foreach ($this->categories as $category) {
          $pid   = (int)$category['pid'];
          $title = htmlspecialchars($category['title'], ENT_QUOTES, 'UTF-8');
          $alias = htmlspecialchars($category['alias'], ENT_QUOTES, 'UTF-8');
          $id    = (int)$category['id'];

          // Création du lien HTML
          $link = '<a href="/voyages/categorie/' . $alias . '" class="category-' . $id . '">' . $title . '</a>';

          if ($pid === 2) {
              $GLOBALS['organisateur'] = $link;
          } elseif ($pid === 3) {
              $GLOBALS['region'] = $link;
          } elseif ($pid === 9) {
              $GLOBALS['thematique'] = $link;
          }
      }
  }

  // 3. Pré-exécution du texte pour peupler les GLOBALS (nécesaire pour la disponibilité)
  $processedText = $this->text;
?>
<div class="voyage_full layout_full block<?= $this->class ?>">
  
  <div class="voyage-header centered-wrapper">
    
      <?php if ($this->addImage): ?>
        <?php $this->insert('image', $this->arrData); ?>
      <?php endif; ?> 
      <div class="centered-wrapper-inner">
        <div class="voyage-title-wrapper">
              <?php if ($GLOBALS['disponibilite']): ?>
                  <div class="voyage-disponibilite is-animated -<?= $GLOBALS['disponibilite_class'] ?>">
                      <?= $GLOBALS['disponibilite'] ?>
                  </div>
              <?php endif; ?>         
            <h1 class="voyage-title is-animated"><?= $this->newsHeadline ?></h1>
            <?php if ($this->hasSubHeadline): ?>
               <h2 class="voyage-subtitle is-animated"><?= $this->subHeadline ?></h2>
            <?php endif; ?>
          <div class="voyage-archive is-animated"><?= $this->archive->title; ?></div> 
          <?php if ($GLOBALS['disponibilite_class'] !== 'complet'): ?>
            <div class="voyage-reserver-action is-animated" style="margin-top: 20px;">
              <a href="#reservation-tally" class="button">Réserver</a>
            </div>
          <?php endif; ?>
        </div>
      </div>
  </div>
  <?php /* if ($this->categories && is_array($this->categories)) : ?>
    <div class="news-boxed-categories">
        <?php
            foreach ($this->categories as $category) {
                $title = htmlspecialchars($category['title'], ENT_QUOTES, 'UTF-8');
                $alias = htmlspecialchars($category['alias'], ENT_QUOTES, 'UTF-8');
                echo '<a class="news-category-btn button -small category-' . $category['id'] . '" href="{{link_url::297}}/categorie/' . $alias . '">' . $title . '</a>';
            }
        ?>
    </div>
  <?php endif; */?>
  <?php if ($this->hasMetaFields): ?>
    <p class="info"><time datetime="<?= $this->datetime ?>"><?= $this->date ?></time> <?= $this->author ?> <?= $this->commentCount ?></p>
  <?php endif; ?>

    <?php if( $this->tags ): ?>
        <div class="tags">
            <?php // dump($this) ?>
            <?php foreach( $this->tags as $tag ): ?>
            <?php // dump($tag) ?>
                <a href="/actualites/tag/<?= $tag; ?>" class="tag-wrapper">
                    <?= $tag; ?>
                </a>
            <?php endforeach; ?>
        </div>
    <?php endif; ?>

  <?php if ($this->hasText): ?>
      <div class="centered-wrapper">
        <div class="centered-wrapper-inner">
          <?= $processedText ?>
        </div>
      </div>
  <?php else: ?>
    <div class="ce_text block">
      <?php if (!$this->addBefore): ?>
        <?= $this->teaser ?>
      <?php endif; ?>

      <?php if ($this->addImage): ?>
        <?php $this->insert('image', $this->arrData); ?>
      <?php endif; ?>

      <?php if ($this->addBefore): ?>
        <?= $this->teaser ?>
      <?php endif; ?>
    </div>
  <?php endif; ?>

  <?php if ($this->enclosure): ?>
    <ul class="enclosure">
      <?php foreach ($this->enclosure as $enclosure): ?>
        <li class="download-element ext-<?= $enclosure['extension'] ?>">
          <a href="<?= $enclosure['href'] ?>" title="<?= $enclosure['title'] ?>"><?= $enclosure['link'] ?> <span class="size">(<?= $enclosure['filesize'] ?>)</span></a>
        </li>
      <?php endforeach; ?>
    </ul>
  <?php endif; ?>

</div>

<?php

$schemaOrg = $this->getSchemaOrgData();

if ($this->hasText) {
    $schemaOrg['text'] = $this->rawHtmlToPlainText($processedText);
}

$this->addSchemaOrg($schemaOrg);
