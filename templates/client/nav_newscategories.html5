
<ul class="<?= $this->level ?><?php if ($this->isActiveCategories): ?> active-categories<?php endif; ?>">
    <?php foreach ($this->items as $item): ?>
        
        <?php if ($item['isActive']): ?>
            <li class="<?= $item['class'] ?>">
                <?php if ($item['image']): ?>
                    <?php $this->insert('picture_default', $item['image']->picture) ?>
                <?php endif; ?>

                <strong class="<?= $item['class'] ?>"<?php if ($item['subitems']): ?> aria-haspopup="true"<?php endif; ?>>
                    <span class="name" itemprop="name"><?= $item['link'] ?></span>

                    <?php if ($this->showQuantity): ?>
                        <sup class="quantity">(<?= $item['quantity'] ?>)</sup>
                    <?php endif; ?>
                </strong>

                <?= $item['subitems'] ?>
            </li>
        <?php else: ?>
            <li class="<?= $item['class'] ?>">
                <span data-href="<?= base64_encode(str_replace(' ', '', $item['href'])) ?>" class="<?= $item['class'] ?> js-cat-link" title="<?= $item['linkTitle'] ?>" role="link" tabindex="0" style="cursor:pointer"<?php if ($item['subitems']): ?> aria-haspopup="true"<?php endif; ?>>
                    <?php if ($item['image']): ?>
                        <?php $this->insert('picture_default', $item['image']->picture) ?>
                    <?php endif; ?>

                    <span class="name" itemprop="name"><?= $item['link'] ?></span>

                    <?php if ($this->showQuantity): ?>
                        <sup class="quantity">(<?= $item['quantity'] ?>)</sup>
                    <?php endif; ?>
                </span>

                <?= $item['subitems'] ?>
            </li>
        <?php endif; ?>
    <?php endforeach; ?>
</ul>
