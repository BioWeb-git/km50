<?php 
// 1. Initialisation des variables
$organisateur = null;
$region       = null;
$thematique   = null; 

// 2. Tri des catégories
if ($this->categories && is_array($this->categories)) {
    foreach ($this->categories as $category) {
        $pid   = (int)$category['pid'];
        $title = htmlspecialchars($category['title'], ENT_QUOTES, 'UTF-8');
        $alias = htmlspecialchars($category['alias'], ENT_QUOTES, 'UTF-8');
        $id    = (int)$category['id'];

        // Création du lien HTML
        $link = '<a href="/voyages/categorie/' . $alias . '" class="category-' . $id . '">' . $title . '</a>';

        if ($pid === 2) {
            $GLOBALS['organisateur'] = $link;
        } elseif ($pid === 3) {
            $GLOBALS['region'] = $link;
        } elseif ($pid === 9) {
            $GLOBALS['thematique'] = $link;
        }
    }
}

// 3. Pré-exécution du texte pour peupler les GLOBALS
$processedText = $this->text;
?>

<div class="voyages-master block<?= $this->class ?>">
    <?php if ($this->addImage && $this->src): ?>
        <?php if ($this->link): ?>
            <a class="voyage-image" href="<?= $this->link ?>"<?php if ($this->target): ?> target="_blank" rel="noopener"<?php endif ?><?= $this->attributes ?>>
        <?php else: ?>
            <div class="voyage-image">
        <?php endif ?>
			<div class="voyage-title">
                <?php if ($GLOBALS['disponibilite']): ?>
                    <div class="voyage-disponibilite -<?= $GLOBALS['disponibilite_class'] ?>">
                        <?= $GLOBALS['disponibilite'] ?>
                    </div>
                <?php endif; ?>
				<h2>
						<?= $this->newsHeadline ?>
				</h2>
				<?php if ($this->hasSubHeadline): ?>
					<div class="voyage-subtitle"><?= $this->subHeadline ?></div>
				<?php endif; ?>
                <?php if ($GLOBALS['region']): ?>
                    <div class="voyage-region">
                        {{fa::map-marker-alt}}&nbsp;<?= $GLOBALS['region'] ?>
                    </div>
                <?php endif; ?>
			</div> 
            <?php $this->insert('picture_default', $this->picture) ?>
			<div class="voyage-image-overlay"></div>
        <?php if ($this->link): ?>
            </a>
        <?php else: ?>
            </div>
        <?php endif ?>
    <?php endif ?>

    <div class="voyage-main-wrapper">
        <div class="voyage-archive">
            <?= $this->archive->title; ?>
        </div>
       
        <?php if ($this->hasText): ?>
            <div class="voyage-content">
                <?= $processedText ?>
            </div>
        <?php endif; ?>

        <?php if ($this->link): ?>
            <a class="button" href="<?= $this->link ?>"<?php if ($this->target): ?> target="_blank" rel="noopener"<?php endif ?><?= $this->attributes ?>>
                Afficher le voyage
            </a>
        <?php endif ?>
    </div>  
</div>