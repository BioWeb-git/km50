<ul class="<?= $this->level ?><?php if ($this->isActiveCategories): ?> active-categories<?php endif; ?>">
  <?php foreach ($this->items as $item): ?>
      <?php $tag = (isset($item['hideInList']) && $item['hideInList']) ? 'span' : 'a'; ?>
      <?php $hideInList = (isset($item['hideInList']) && $item['hideInList']) ? 'hideInList' : ''; ?>
      
      <?php 
        // On détermine le label : "Réinitialiser" si la classe contient 'reset', sinon le lien original
        $label = str_contains((string) $item['class'], 'reset') ? 'Réinitialiser' : $item['link']; 
      ?>

      <li class="<?= $item['class'] ?>">
        <?php if (!str_contains((string) $item['class'], 'reset') || !str_contains((string) $item['class'], 'active')): ?>
        <?php if ('a' === $tag): ?>
        <span 
            class="<?= $item['class'] ?> <?= $hideInList ?> js-cat-link" 
            data-href="<?= base64_encode($item['href']) ?>" 
            title="<?= $item['linkTitle'] ?>" 
            role="link" 
            tabindex="0" 
            style="cursor:pointer"
            <?php if ($item['subitems']): ?> aria-haspopup="true"<?php endif; ?>
        >
        <?php else: ?>
        <<?= $tag ?> 
            class="<?= $item['class'] ?> <?= $hideInList ?>" 
            <?php if ($item['subitems']): ?> aria-haspopup="true"<?php endif; ?>
        >
        <?php endif; ?>
        <?php endif; ?>

          <?php if ($item['image']): ?>
            <?php $this->insert('picture_default', $item['image']['picture']) ?>
          <?php endif; ?>

          <?php if ($item['isActive']): ?>
            <strong class="<?= $item['class'] ?>"<?php if ($item['subitems']): ?> aria-haspopup="true"<?php endif; ?>>
          <?php endif; ?>

          <span class="name" itemprop="name"><?= $label ?></span>

          <?php if ($this->showQuantity): ?>
            <span class="quantity"><?= $item['quantity'] ?></span>
          <?php endif; ?>

          <?php if ($item['isActive']): ?>
            </strong>
          <?php endif; ?>

        <?php if (!str_contains((string) $item['class'], 'reset') || !str_contains((string) $item['class'], 'active')): ?>
        </<?= 'a' === $tag ? 'span' : $tag ?>>
        <?php endif; ?>

        <?= $item['subitems'] ?>
      </li>
  <?php endforeach; ?>
</ul>